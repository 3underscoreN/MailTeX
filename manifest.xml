<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0" xsi:type="MailApp">
  <Id>18c5e794-73e5-4d44-87b0-506a70e114ff</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Kelvin</ProviderName>
  <DefaultLocale>en-HK</DefaultLocale>
  <DisplayName DefaultValue="MailTex"/>
  <Description DefaultValue="An add-in for rendering TeX in Outlook messages."/>
  <IconUrl DefaultValue="https://mailtex.3underscoren.work/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://mailtex.3underscoren.work/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://github.com/3underscoreN/MailTex"/>
  <AppDomains>
    <AppDomain>https://mailtex.3underscoren.work</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://mailtex.3underscoren.work/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="composeTexGroup">
                <Label resid="ComposeGroupLabel"/>
                <Control xsi:type="Button" id="composeOpenPaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://mailtex.3underscoren.work/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://mailtex.3underscoren.work/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://mailtex.3underscoren.work/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://mailtex.3underscoren.work/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="ComposeGroupLabel" DefaultValue="MailTex"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Open MailTex"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Opens the MailTex task pane."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>